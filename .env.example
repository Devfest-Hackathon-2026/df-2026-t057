APP_MODE=demo
PORT=8080
GOOGLE_CLOUD_PROJECT=devfest-2026-513816
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_LOCATION=global
APP_URL=http://127.0.0.1:4200
# Live mode: Firebase consoleのWebアプリ公開設定（JSON）
FIREBASE_WEB_CONFIG=
# Calendar OAuth web client; secretはローカル.env／Cloud RunのSecret Manager参照へ
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Chat HTTP endpointの認証audience（公開URL）
CHAT_AUDIENCE=
# 監視更新の実行を保護する長いランダム値（Schedulerの認証）
SCHEDULER_SECRET=
