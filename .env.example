APP_MODE=demo
PORT=8080
GOOGLE_CLOUD_PROJECT=devfest-2026-513816
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_LOCATION=global
# Gemini呼び出し回数。日次はUTC 00:00、分次はUTCの各分にリセット。
AI_USER_PER_MINUTE=5
AI_USER_PER_DAY=30
AI_GLOBAL_PER_MINUTE=30
AI_GLOBAL_PER_DAY=300
APP_URL=http://127.0.0.1:4200
# Live mode: Firebase consoleのWebアプリ公開設定（JSON）
FIREBASE_WEB_CONFIG=
# Calendar OAuth web client; secretはローカル.env／Cloud RunのSecret Manager参照へ
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 監視更新の実行を保護する長いランダム値（Schedulerの認証）
SCHEDULER_SECRET=

# 公開版・開発版の許可したChrome拡張ID（空白区切り）
EXTENSION_IDS=
# 同期再試行・削除ジョブのScheduler OIDC呼び出し元（本人データの権限は付与しない）
MAINTENANCE_EMAIL=
# 保守ジョブ・最小権限・Emulator/実環境確認が済んだ場合だけtrue
ACCOUNT_CLEANUP_ENABLED=false
