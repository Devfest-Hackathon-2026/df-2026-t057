# ローカルでは APP_MODE=demo（既定）で動く。Google認証・AI・カレンダーを使わない。
APP_MODE=demo
PORT=8080
APP_URL=http://127.0.0.1:4200

# ── 以下は APP_MODE=live のとき ──
# 本番のプロジェクトを既定値にしない。live では必須で、無ければ起動しない。
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Firebase consoleのWebアプリの公開設定（JSON）
FIREBASE_WEB_CONFIG=
# 状態を変えるリクエストを受け付ける Chrome 拡張のID（カンマ区切り）
EXTENSION_IDS=
# Gemini呼び出し回数。日次はUTC 00:00、分次はUTCの各分にリセット。
AI_USER_PER_MINUTE=10
AI_USER_PER_DAY=500
AI_GLOBAL_PER_MINUTE=60
AI_GLOBAL_PER_DAY=2000

# ── Googleカレンダー連携（GOOGLE_OAUTH_CLIENT_ID を設定すると、以下も必須） ──
GOOGLE_OAUTH_CLIENT_ID=
# secret はローカルの .env か、Cloud Run の Secret Manager 参照で渡す
GOOGLE_OAUTH_CLIENT_SECRET=
# Outbox のジョブを流す Cloud Tasks のキュー（projects/<p>/locations/<r>/queues/<q>）
CLOUD_TASKS_QUEUE=
# Cloud Tasks / Cloud Scheduler が OIDC トークンに使うサービスアカウント
CLOUD_TASKS_INVOKER=
SCHEDULER_INVOKER=
# OIDC トークンの audience（既定は APP_URL）
OIDC_AUDIENCE=

# 保守ジョブとFirebase/Secretの権限を確認してから有効にする。
ACCOUNT_CLEANUP_ENABLED=false
