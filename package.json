{
  "name": "dopagaki",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd api && APP_MODE=demo PORT=8080 go run ./cmd/server",
    "dev:web": "ng serve --host 127.0.0.1 --port 4200 --proxy-config web/proxy.json",
    "build": "ng build && npm run build:extension",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit -p extension/tsconfig.json",
    "test": "npm run typecheck && npm run test:unit && cd api && go test -race ./...",
    "test:e2e": "playwright test",
    "format": "prettier --write 'web/src/**/*.{ts,html,scss}' 'extension/src/**/*.ts' 'shared/**/*.ts'",
    "test:unit": "node --test tests/timing.test.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/cdk": "22.2.6",
    "@angular/material": "22.2.6",
    "firebase": "13.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "material-symbols": "^0.40.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "@types/chrome": "^0.1.27",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "type": "module"
}
