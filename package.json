{
  "name": "dopagaki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dopagaki/api --filter @dopagaki/web dev",
    "generate": "pnpm --recursive --if-present generate",
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "lint": "pnpm lint:ts && pnpm lint:css && pnpm --recursive --if-present lint",
    "lint:ts": "eslint --max-warnings=0 .",
    "lint:css": "stylelint --max-warnings=0 \"apps/**/*.{css,scss}\" \"packages/**/*.{css,scss}\"",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present --filter '!@dopagaki/e2e' test",
    "test:e2e": "pnpm --filter @dopagaki/e2e test",
    "format": "prettier --write . && gofmt -w apps/api",
    "format:check": "prettier --check . && test -z \"$(gofmt -l apps/api)\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
